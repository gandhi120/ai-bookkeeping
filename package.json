{
  "name": "ai-bookkeeping",
  "version": "1.0.0",
  "description": "AI-powered bookkeeping assistant using Telegram, Node.js, Groq, PostgreSQL, and Google Sheets",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node src/telegram/bot.js",
    "dev": "node --watch src/telegram/bot.js",
    "bot": "node src/telegram/bot.js",
    "test": "node tests/schema.test.js && node tests/summary.test.js && node tests/ratelimit.test.js",
    "test:db": "node tests/udhaar.integration.js",
    "test:ws": "node tests/workspace.integration.js",
    "test:onb": "node tests/onboarding.integration.js",
    "test:all": "npm test && npm run test:db && npm run test:ws && npm run test:onb",
    "test:ai": "node tests/ai.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gandhi120/ai-bookkeeping.git"
  },
  "keywords": [
    "ai",
    "bookkeeping",
    "telegram",
    "nodejs",
    "postgresql",
    "groq"
  ],
  "author": "Varun Gandhi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gandhi120/ai-bookkeeping/issues"
  },
  "homepage": "https://github.com/gandhi120/ai-bookkeeping#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "groq-sdk": "^1.5.0",
    "node-telegram-bot-api": "^1.2.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
